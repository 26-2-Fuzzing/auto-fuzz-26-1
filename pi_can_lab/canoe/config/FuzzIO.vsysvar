<?xml version='1.0' encoding='utf-8'?>
<systemvariables version="4">
  <namespace name="" comment="" interface="">
    <namespace name="FuzzIO" comment="Raw Classic CAN three-channel transport; no DBC required." interface="">
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="" name="TxChannel" comment="Input: 1, 2 or 3. Write all fields before TxRequestSeq." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="1" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="" name="TxId" comment="Input: numeric arbitration ID, without the extended-format marker." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="" name="TxExtended" comment="Input: 0 for standard 11-bit ID; 1 for extended 29-bit ID." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="" name="TxDlc" comment="Input: 0..8 data bytes. Classic CAN data frames only." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="" name="TxData" comment="Input: fixed array of eight integers, each 0..255; unused padding is also validated." bitcount="32" isSigned="true" encoding="65001" type="intarray" arrayLength="8" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="" name="TxRequestSeq" comment="Input commit: strictly increasing positive signed 32-bit sequence. Write LAST and await TxDoneSeq." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="" name="TxDoneSeq" comment="CAPL-owned output: completed request sequence; written LAST after TxResult and counters." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="" name="TxResult" comment="CAPL-owned: 0 idle, 1 submitted (not physical Tx confirmed), -1 sequence, -2 duplicate, -3 channel, -4 format, -5 ID, -6 DLC, -7 byte, -8 array, -9 latched bus-off, -10 not ready." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="frames" name="RxCount1" comment="CAPL-owned: received frame events on CAN1, excluding own Tx events." bitcount="64" isSigned="true" encoding="65001" type="longlong" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="frames" name="RxCount2" comment="CAPL-owned: received frame events on CAN2, excluding own Tx events." bitcount="64" isSigned="true" encoding="65001" type="longlong" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="frames" name="RxCount3" comment="CAPL-owned: received frame events on CAN3, excluding own Tx events." bitcount="64" isSigned="true" encoding="65001" type="longlong" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="requests" name="TxSubmitted1" comment="CAPL-owned: accepted output() calls for CAN1, not physical transmission confirmations." bitcount="64" isSigned="true" encoding="65001" type="longlong" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="requests" name="TxSubmitted2" comment="CAPL-owned: accepted output() calls for CAN2, not physical transmission confirmations." bitcount="64" isSigned="true" encoding="65001" type="longlong" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="requests" name="TxSubmitted3" comment="CAPL-owned: accepted output() calls for CAN3, not physical transmission confirmations." bitcount="64" isSigned="true" encoding="65001" type="longlong" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="" name="BusOff1" comment="CAPL-owned: CAN1 bus-off latched flag; clear only by restarting measurement." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="" name="BusOff2" comment="CAPL-owned: CAN2 bus-off latched flag; clear only by restarting measurement." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="" name="BusOff3" comment="CAPL-owned: CAN3 bus-off latched flag; clear only by restarting measurement." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="events" name="ErrorFrame1" comment="CAPL-owned: CAN1 errorFrame handler count, including overload/protocol exceptions." bitcount="64" isSigned="true" encoding="65001" type="longlong" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="events" name="ErrorFrame2" comment="CAPL-owned: CAN2 errorFrame handler count, including overload/protocol exceptions." bitcount="64" isSigned="true" encoding="65001" type="longlong" startValue="0" />
      <variable anlyzLocal="2" readOnly="false" valueSequence="false" unit="events" name="ErrorFrame3" comment="CAPL-owned: CAN3 errorFrame handler count, including overload/protocol exceptions." bitcount="64" isSigned="true" encoding="65001" type="longlong" startValue="0" />
    </namespace>
